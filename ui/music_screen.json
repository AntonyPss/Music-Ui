{
    "namespace": "music",

    /* ============================================
     ANIMATIONS
     ============================================ */
    "anim_alpha_screen": {
        "anim_type": "alpha",
        "easing": "in_out_expo",
        "duration": 0.5,
        "from": 0,
        "to": 1
    },

    "anim_offset_screen": {
        "anim_type": "offset",
        "easing": "in_out_expo",
        "duration": 0.5,
        "from": [0, -16],
        "to": [0, 0]
    },

    /* ============================================
     ICONS (ESTADOS SEPARADOS)
     ============================================ */
    "icon_base": {
        "type": "image",
        "layer": 1,
        "size": [16, 16]
    },

    // Definición por pares (Normal y Color/Hover) para evitar conflictos de variables
    "tooltip_icon@music.icon_base": { "texture": "textures/icons/tooltip" },
    "tooltip_icon_hover@music.icon_base": {
        "texture": "textures/icons/tooltip_color"
    },

    "about_icon@music.icon_base": { "texture": "textures/icons/about" },
    "about_icon_hover@music.icon_base": {
        "texture": "textures/icons/about_color"
    },

    "info_icon@music.icon_base": { "texture": "textures/icons/menu" },
    "info_icon_hover@music.icon_base": {
        "texture": "textures/icons/menu_color"
    },

    "close_icon@music.icon_base": { "texture": "textures/icons/close" },
    "close_icon_hover@music.icon_base": {
        "texture": "textures/icons/close_color"
    },

    "play_icon@music.icon_base": { "texture": "textures/icons/play" },
    "play_icon_hover@music.icon_base": {
        "texture": "textures/icons/play_color"
    },

    "stop_icon@music.icon_base": { "texture": "textures/icons/stop" },
    "stop_icon_hover@music.icon_base": {
        "texture": "textures/icons/stop_color"
    },

    "popup_close_icon@music.icon_base": {
        "texture": "textures/ui/popup/close"
    },
    "popup_close_icon_hover@music.icon_base": {
        "texture": "textures/ui/popup/close_color"
    },

    "music_main_icon@music.icon_base": {
        "texture": "textures/buttons/music",
        "size": [22, 24]
    },
    "music_main_icon_hover@music.icon_base": {
        "texture": "textures/buttons/music_hover",
        "size": [22, 24]
    },
    "music_main_icon_pressed@music.icon_base": {
        "texture": "textures/buttons/music_pressed",
        "size": [22, 24]
    },

    "scroll_icon": {
        "type": "image",
        "texture": "textures/ui/scroll_box",
        "layer": 1
    },

    /* ============================================
     BUTTONS BASE
     ============================================ */
    "button@common.button": {
        "$default_content|default": "common.empty_panel",
        "$hover_content|default": "common.empty_panel",
        "$pressed_content|default": "common.empty_panel",
        "controls": [
            { "default@$default_content": {} },
            { "hover@$hover_content": {} },
            { "pressed@$pressed_content": {} }
        ]
    },

    /* ============================================
     HEADER SECTION
     ============================================ */
    "header_title": {
        "type": "label",
        "anchor_from": "left_middle",
        "anchor_to": "left_middle",
        "color": "$main_header_text_color",
        "font_scale_factor": 1.1,
        "font_type": "MinecraftTen",
        "text": "music.screen.title"
    },

    "header_icon": {
        "type": "panel",
        "anchor_from": "left_middle",
        "anchor_to": "left_middle",
        "size": [24, 24],
        "offset": [0, 0],
        "controls": [
            {
                "icon": {
                    "type": "image",
                    "texture": "textures/icons/format",
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "layer": 3,
                    "anims": ["@music.header_icon_beat_up"]
                }
            }
        ]
    },

    "header_icon_beat_up": {
        "anim_type": "size",
        "easing": "out_back",
        "duration": 0.25,
        "from": [16, 16],
        "to": [20, 20],
        "next": "@music.header_icon_beat_down"
    },

    "header_icon_beat_down": {
        "anim_type": "size",
        "easing": "in_quad",
        "duration": 0.35,
        "from": [20, 20],
        "to": [16, 16],
        "next": "@music.header_icon_beat_up"
    },

    "header_section_panel": {
        "type": "image",
        "size": ["100%", 24],
        "texture": "textures/ui/headerBar",
        "controls": [
            {
                "header_icon@music.header_icon": {
                    "offset": [2, 0]
                }
            },
            {
                "header_title@music.header_title": {
                    "offset": [26, -1]
                }
            },
            {
                "right_buttons": {
                    "type": "stack_panel",
                    "anchor_from": "right_middle",
                    "anchor_to": "right_middle",
                    "offset": [-5, 0],
                    "orientation": "horizontal",
                    "size": ["100%c", 18],
                    "controls": [
                        {
                            "about_btn@common_toggles.light_image_toggle": {
                                "$radio_toggle_group": true,
                                "$toggle_default_state": false,
                                "$toggle_group_forced_index": 1,
                                "$toggle_name": "popup_overlay",
                                "$toggle_view_binding_name": "about_popup_toggle",
                                "$unchecked_control": "music.about_icon",
                                "$checked_control": "music.about_icon_hover",
                                "$unchecked_hover_control": "music.about_icon_hover",
                                "$checked_hover_control": "music.about_icon_hover",
                                "size": [18, 18]
                            }
                        },
                        { "spacer1": { "type": "panel", "size": [1, 0] } },
                        {
                            "tooltip_btn@common_toggles.light_image_toggle": {
                                "$radio_toggle_group": true,
                                "$toggle_default_state": false,
                                "$toggle_group_forced_index": 2,
                                "$toggle_name": "popup_overlay",
                                "$toggle_view_binding_name": "tooltip_popup_toggle",
                                "$unchecked_control": "music.tooltip_icon",
                                "$checked_control": "music.tooltip_icon_hover",
                                "$unchecked_hover_control": "music.tooltip_icon_hover",
                                "$checked_hover_control": "music.tooltip_icon_hover",
                                "size": [18, 18]
                            }
                        },
                        { "spacer2": { "type": "panel", "size": [1, 0] } },
                        {
                            "close_btn@music.button": {
                                "$pressed_button_name": "button.menu_exit",
                                "$default_content": "music.close_icon",
                                "$hover_content": "music.close_icon_hover",
                                "$pressed_content": "music.close_icon_hover",
                                "size": [18, 18]
                            }
                        }
                    ]
                }
            }
        ]
    },

    /* ============================================
     MAIN SECTION
     ============================================ */
    "scrolling_section_base@common.scrolling_panel": {
        "$scroll_box_mouse_image_control": "music.scroll_icon",
        "$scroll_size": [6, "100% - 4px"],
        "$show_background": false,
        "layer": 6,
        "variables": [
            {
                "requires": "$touch",
                "$use_touch_mode": false
            }
        ]
    },

    "main_section_panel": {
        "type": "image",
        "size": ["100%", "fill"],
        "texture": "textures/ui/contentBackground",
        "controls": [
            {
                "content": {
                    "type": "panel",
                    "size": ["100% - 6px", "100% - 6px"],
                    "controls": [
                        {
                            "main_section@music.scrolling_section_base": {
                                "$scrolling_content": "music_list.main_list_content",
                                "bindings": [
                                    {
                                        "binding_type": "view",
                                        "source_control_name": "main_section_toggle",
                                        "source_property_name": "#toggle_state",
                                        "target_property_name": "#visible"
                                    }
                                ]
                            }
                        },
                        {
                            "custom_section@music.scrolling_section_base": {
                                "$scrolling_content": "music_list.custom_list_content",
                                "bindings": [
                                    {
                                        "binding_type": "view",
                                        "source_control_name": "custom_section_toggle",
                                        "source_property_name": "#toggle_state",
                                        "target_property_name": "#visible"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    /* ============================================
     FOOTER SECTION
     ============================================ */
    "tab_section_wrapper": {
        "type": "label",
        "color": "$main_header_text_color",
        "layer": 3,
        "text": "$toggle_text"
    },

    "tab_section_toggle@settings_common.section_toggle_base": {
        "$button_type_panel": "music.tab_section_wrapper",
        "$default_border_visible": false,
        "$default_texture": "textures/buttons/normal",
        "$hover_border_visible": false,
        "$hover_texture": "textures/buttons/hover",
        "$pressed_no_hover_texture": "textures/buttons/hover",
        "$pressed_texture": "textures/buttons/pressed",
        "$toggle_name": "tab_section_toggle",
        "anchor_from": "$tab_anchor",
        "anchor_to": "$tab_anchor",
        "offset": "$tab_offset",
        "size": ["50% - 4px", 24]
    },

    "footer_section_panel": {
        "type": "image",
        "$default_selector_toggle_index": 0,
        "size": ["100%", 32],
        "texture": "textures/ui/footerBar",
        "controls": [
            {
                "main_section_tab@music.tab_section_toggle": {
                    "$tab_anchor": "left_middle",
                    "$tab_offset": [4, 0],
                    "$toggle_group_forced_index": 0,
                    "$toggle_text": "music.tabSection.main",
                    "$toggle_view_binding_name": "main_section_toggle"
                }
            },
            {
                "custom_section_tab@music.tab_section_toggle": {
                    "$tab_anchor": "right_middle",
                    "$tab_offset": [-4, 0],
                    "$toggle_group_forced_index": 1,
                    "$toggle_text": "music.tabSection.custom",
                    "$toggle_view_binding_name": "custom_section_toggle"
                }
            }
        ]
    },

    /* ============================================
     TRACK ITEMS & MEDIA BUTTONS
     ============================================ */
    "media_tooltip": {
        "type": "image",
        "$hover_text|default": "",
        "$tooltip_offset|default": [8, -8],
        "anchor_to": "right_middle",
        "anchor_from": "left_middle",
        "layer": 28,
        "offset": "$tooltip_offset",
        "size": ["100%c + 12px", "100%c + 6px"],
        "texture": "textures/ui/purpleBorder",
        "controls": [
            {
                "tooltip_label": {
                    "type": "label",
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "color": "$main_header_text_color",
                    "layer": 29,
                    "shadow": true,
                    "text": "$hover_text"
                }
            }
        ]
    },

    "media_hover_state": {
        "type": "panel",
        "controls": [
            {
                "icon@$hover_content": {
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "layer": 2,
                    "$is_hover": true
                }
            },
            { "tooltip@music.media_tooltip": {} }
        ]
    },

    "media_control_button@music.button": {
        "$songAudio|default": "random.click",
        "$soundVolume|default": 1.0,
        "$action_size|default": [20, 20],
        "layer": 4,
        "size": "$action_size",
        "sound_name": "$songAudio",
        "sound_pitch": 1.0,
        "sound_volume": "$soundVolume",
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "focused"
            }
        ],
        "controls": [
            {
                "default@$default_content": {
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "layer": 2,
                    "$is_hover": false
                }
            },
            {
                "hover@music.media_hover_state": {
                    "anchor_from": "center",
                    "anchor_to": "center"
                }
            },
            {
                "pressed@$pressed_content": {
                    "alpha": 0.8,
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "layer": 2,
                    "$is_hover": true
                }
            }
        ]
    },

    "details_track_toggle@common_toggles.light_image_toggle": {
        "$toggle_name": "details_track_panel",
        "$toggle_view_binding_name": "$songAudio",
        "$unchecked_control": "music.info_icon",
        "$checked_control": "music.info_icon_hover",
        "$unchecked_hover_control": "music.info_icon",
        "$checked_hover_control": "music.info_icon_hover",
        "layer": 4
    },

    "track_item_label": {
        "type": "label",
        "anchor_from": "$item_anchor",
        "anchor_to": "$item_anchor",
        "color": "$main_header_text_color",
        "layer": 3
    },

    "duration_badge": {
        "type": "image",
        "alpha": 0.4,
        "layer": 3,
        "size": ["100%c + 8px", "100%c + 4px"],
        "texture": "textures/ui/hud_tip_text_background",
        "controls": [
            {
                "duration_label@music.track_item_label": {
                    "$item_anchor": "center",
                    "layer": 4,
                    "size": ["default", "default"],
                    "text": "$songDuration"
                }
            }
        ]
    },

    "track_bg_image": {
        "type": "image",
        "$trackItemTexture|default": "textures/ui/trackBackground",
        "texture": "$trackItemTexture"
    },

    /* ---------- music_track_card: sub-componentes ---------- */

    "track_bg_button@common.button": {
        "$pressed_button_name": "button.track",
        "layer": 1,
        "size": ["100%", "100% - 1px"],
        "controls": [
            { "default@music.track_bg_image": {} },
            {
                "hover@music.track_bg_image": {
                    "$trackItemTexture": "textures/ui/trackBackgroundHover"
                }
            },
            {
                "pressed@music.track_bg_image": {
                    "$trackItemTexture": "textures/ui/trackBackgroundHover",
                    "alpha": 0.8
                }
            }
        ]
    },

    "track_cover": {
        "type": "panel",
        "size": ["100%y", "100%"],
        "controls": [
            {
                "cover_border": {
                    "type": "image",
                    "texture": "textures/ui/trackBackground",
                    "layer": 3,
                    "size": [24, 24]
                }
            },
            {
                "cover_art": {
                    "type": "image",
                    "texture": "$songCover",
                    "layer": 4,
                    "size": [22, 22]
                }
            }
        ]
    },

    "track_text_line": {
        "type": "panel",
        "size": ["100%", "100%c"],
        "clips_children": true,
        "$line_text|default": "#none",
        "$line_color|default": [1, 1, 1],
        "$line_font|default": "default",
        "controls": [
            {
                "label@music.track_item_label": {
                    "$item_anchor": "left_middle",
                    "color": "$line_color",
                    "font_type": "$line_font",
                    "text": "$line_text"
                }
            }
        ]
    },

    "track_metadata": {
        "type": "panel",
        "size": ["fill", "100%"],
        "controls": [
            {
                "text_stack": {
                    "type": "stack_panel",
                    "orientation": "vertical",
                    "anchor_from": "left_middle",
                    "anchor_to": "left_middle",
                    "size": ["100%", "100%c"],
                    "controls": [
                        {
                            "track_name@music.track_text_line": {
                                "$line_text": "$songName",
                                "$line_color": "$track_name_text_color",
                                "$line_font": "MinecraftTen"
                            }
                        },
                        { "gap": { "type": "panel", "size": [0, 2] } },
                        {
                            "track_artist@music.track_text_line": {
                                "$line_text": "$songArtist",
                                "$line_color": "$track_artist_text_color"
                            }
                        }
                    ]
                }
            }
        ]
    },

    "track_duration": {
        "type": "panel",
        "size": ["100%c", "100%"],
        "controls": [
            {
                "badge@music.duration_badge": {
                    "anchor_from": "center",
                    "anchor_to": "center"
                }
            }
        ]
    },

    "track_actions": {
        "type": "panel",
        "size": ["100%c", "100%"],
        "controls": [
            {
                "actions_stack": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "size": ["100%c", 18],
                    "$action_size": [18, 18],
                    "controls": [
                        { "duration@music.track_duration": {} },
                        { "gap_duration": { "type": "panel", "size": [6, 0] } },
                        {
                            "play_btn@music.media_control_button": {
                                "$pressed_button_name": "button.play",
                                "$soundVolume": 1.0,
                                "$default_content": "music.play_icon",
                                "$hover_content": "music.play_icon_hover",
                                "$pressed_content": "music.play_icon_hover",
                                "$hover_text": "music.card.play.hover"
                            }
                        },
                        { "gap_play": { "type": "panel", "size": [2, 0] } },
                        {
                            "stop_btn@music.media_control_button": {
                                "$pressed_button_name": "button.stop",
                                "$soundVolume": 0.0001,
                                "$default_content": "music.stop_icon",
                                "$hover_content": "music.stop_icon_hover",
                                "$pressed_content": "music.stop_icon_hover",
                                "$hover_text": "music.card.stop.hover"
                            }
                        },
                        { "gap_stop": { "type": "panel", "size": [2, 0] } },
                        {
                            "details_tgl@music.details_track_toggle": {
                                "size": "$action_size"
                            }
                        },
                        {
                            "gap_end": {
                                "type": "panel",
                                "size": ["25%y", "100%"]
                            }
                        }
                    ]
                }
            }
        ]
    },

    "track_details_overlay": {
        "type": "panel",
        "anchor_from": "top_right",
        "anchor_to": "top_right",
        "size": ["100%cm", "100%cm"],
        "offset": [-16, 2],
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "$songAudio",
                "source_property_name": "#toggle_state",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "details_bg": {
                    "type": "image",
                    "texture": "textures/ui/hud_tip_text_background",
                    "alpha": 0.4,
                    "layer": 10,
                    "size": ["100%sm + 6px", "100%sm + 2px"]
                }
            },
            {
                "details_text": {
                    "type": "label",
                    "text": "$songPath",
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "layer": 11,
                    "shadow": true
                }
            }
        ]
    },

    /* ---------- music_track_card ---------- */
    "music_track_card": {
        "type": "panel",
        "size": ["100% - 2px", 36],
        "controls": [
            { "bg@music.track_bg_button": {} },
            { "details_overlay@music.track_details_overlay": {} },
            {
                "content": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "size": ["100% - 4px", "100% - 2px"],
                    "controls": [
                        { "cover@music.track_cover": {} },
                        { "gap_cover": { "type": "panel", "size": [2, 0] } },
                        { "metadata@music.track_metadata": {} },
                        { "gap_metadata": { "type": "panel", "size": [4, 0] } },
                        { "actions@music.track_actions": {} }
                    ]
                }
            }
        ]
    },

    "empty_library_panel": {
        "type": "image",
        "offset": [0, 8],
        "size": ["100% - 2px", "100%c + 16px"],
        "texture": "textures/ui/hud_tip_text_background",
        "alpha": 0.4,
        "controls": [
            {
                "content_stack": {
                    "type": "stack_panel",
                    "size": ["100%", "100%c"],
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "controls": [
                        {
                            "title": {
                                "type": "label",
                                "color": "$main_header_text_color",
                                "font_scale_factor": 1.1,
                                "font_type": "MinecraftTen",
                                "size": ["100%", "default"],
                                "text": "music.custom.empty.title",
                                "text_alignment": "center"
                            }
                        },
                        { "spacer": { "type": "panel", "size": [0, 4] } },
                        {
                            "message_panel": {
                                "type": "panel",
                                "size": ["100%", "100%c"],
                                "controls": [
                                    {
                                        "message": {
                                            "type": "label",
                                            "color": "$body_text_color",
                                            "size": ["100% - 48px", "default"],
                                            "text": "music.custom.empty.body",
                                            "text_alignment": "center"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    /* ============================================
     MUSIC SCREEN PANEL
     ============================================ */
    "music_screen_panel": {
        "type": "stack_panel",
        "alpha": "@music.anim_alpha_screen",
        "offset": "@music.anim_offset_screen",
        "propagate_alpha": true,
        "size": "$music_screen_size",
        "controls": [
            { "header@music.header_section_panel": {} },
            { "main@music.main_section_panel": {} },
            { "footer@music.footer_section_panel": {} }
        ]
    },

    /* ============================================
     POPUPS (MODALS)
     ============================================ */

    "popup_overlay": {
        "type": "input_panel",
        "modal": true,
        "size": ["100%", "100%"],
        "layer": 30
    },

    "popup_background": {
        "type": "image",
        "texture": "textures/ui/Black",
        "alpha": 0.5,
        "layer": -1
    },

    "popup_base": {
        "type": "panel",

        "$popup_title|default": "#none",
        "$popup_content|default": "common.empty_panel",
        "$popup_size|default": [230, 180],

        "size": "$popup_size",
        "controls": [
            {
                "header": {
                    "type": "image",
                    "texture": "textures/ui/popup/header",
                    "size": ["100%c + 36px", 22],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [0, -10],
                    "layer": 2,
                    "controls": [
                        {
                            "title": {
                                "type": "label",
                                "text": "$popup_title",
                                "color": "$main_header_text_color",
                                "font_type": "MinecraftTen",
                                "font_scale_factor": 1.15,
                                "text_alignment": "center",
                                "max_size": [200, "default"],
                                "layer": 3,
                                "offset": [0, -1]
                            }
                        }
                    ]
                }
            },
            {
                "close_toggle@common_toggles.light_image_toggle": {
                    "$radio_toggle_group": true,
                    "$toggle_default_state": false,
                    "$toggle_group_forced_index": 0,
                    "$toggle_name": "popup_overlay",
                    "$toggle_view_binding_name": "popup_overlay_close",
                    "$unchecked_control": "music.popup_close_icon",
                    "$checked_control": "music.popup_close_icon",
                    "$unchecked_hover_control": "music.popup_close_icon_hover",
                    "$checked_hover_control": "music.popup_close_icon_hover",
                    "anchor_from": "top_right",
                    "anchor_to": "top_right",
                    "layer": 5,
                    "size": [16, 16],
                    "offset": [7, -7]
                }
            },
            {
                "background": {
                    "type": "image",
                    "texture": "textures/ui/popup/body",
                    "size": ["100%", "100%"],
                    "layer": 1,
                    "controls": [
                        {
                            "content@$popup_content": {
                                "anchor_from": "top_middle",
                                "anchor_to": "top_middle",
                                "size": ["100% - 16px", "100%c"],
                                "offset": [0, 16],
                                "layer": 2
                            }
                        }
                    ]
                }
            }
        ]
    },

    "about_popup_overlay@music.popup_overlay": {
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "about_popup_toggle",
                "source_property_name": "#toggle_state",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            { "popup@music.about_popup_base": {} },
            { "bg@music.popup_background": {} }
        ]
    },

    "tooltip_popup_overlay@music.popup_overlay": {
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "tooltip_popup_toggle",
                "source_property_name": "#toggle_state",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            { "popup@music.tooltip_popup_base": {} },
            { "bg@music.popup_background": {} }
        ]
    },

    "about_popup_base@music.popup_base": {
        "$popup_title": "music.aboutSection.title",
        "$popup_content": "music.about_popup_content",
        "$popup_size": [230, 165]
    },

    "tooltip_popup_base@music.popup_base": {
        "$popup_title": "music.tooltip.title",
        "$popup_content": "music.tooltip_popup_content",
        "size": [230, 155]
    },

    "popup_label_with_icon": {
        "type": "image",
        "texture": "textures/ui/wrapper_item",
        "size": ["100%", 30],

        "$wrapper_icon|default": "textures/ui/infobulb",
        "$wrapper_title|default": "Title",
        "$wrapper_value|default": "Value",
        "controls": [
            {
                "row_content": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "anchor_from": "left_middle",
                    "anchor_to": "left_middle",
                    "size": ["100% - 12px", 22],
                    "offset": [6, 0],
                    "layer": 2,
                    "controls": [
                        {
                            "icon_container": {
                                "type": "panel",
                                "size": [22, 22],
                                "controls": [
                                    {
                                        "icon": {
                                            "type": "image",
                                            "texture": "$wrapper_icon",
                                            "anchor_from": "center",
                                            "anchor_to": "center",
                                            "size": [18, 18],
                                            "layer": 3
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "spacer": {
                                "type": "panel",
                                "size": [5, "100%"]
                            }
                        },
                        {
                            "text_stack": {
                                "type": "stack_panel",
                                "orientation": "vertical",
                                "anchor_from": "left_middle",
                                "anchor_to": "left_middle",
                                "size": ["fill", "100%c"],
                                "controls": [
                                    {
                                        "top_padding": {
                                            "type": "panel",
                                            "size": [0, 1]
                                        }
                                    },
                                    {
                                        "title": {
                                            "type": "label",
                                            "text": "$wrapper_title",
                                            "layer": 3,
                                            "color": "$wrapper_title_text_color",
                                            "font_scale_factor": 0.9,
                                            "size": ["100%", 10]
                                        }
                                    },
                                    {
                                        "value": {
                                            "type": "label",
                                            "text": "$wrapper_value",
                                            "layer": 3,
                                            "color": "$wrapper_value_text_color",
                                            "font_scale_factor": 0.95,
                                            "size": ["100%", 12]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    /* About Section */
    "about_popup_content": {
        "type": "stack_panel",
        "controls": [
            {
                "creator_row@music.popup_label_with_icon": {
                    "$wrapper_title": "music.aboutSection.creator",
                    "$wrapper_value": "$music_ui_creator",
                    "$wrapper_icon": "textures/icons/creator"
                }
            },
            { "s2": { "type": "panel", "size": [0, 2] } },
            {
                "version_row@music.popup_label_with_icon": {
                    "$wrapper_title": "music.aboutSection.pack",
                    "$wrapper_value": "$music_ui_version",
                    "$wrapper_icon": "textures/icons/version"
                }
            },
            { "s3": { "type": "panel", "size": [0, 2] } },
            {
                "last_update_row@music.popup_label_with_icon": {
                    "$wrapper_title": "music.aboutSection.lastUpdate",
                    "$wrapper_value": "$music_ui_last_update",
                    "$wrapper_icon": "textures/icons/update"
                }
            },
            { "s4": { "type": "panel", "size": [0, 2] } },
            {
                "discord_row@music.popup_label_with_icon": {
                    "$wrapper_icon": "textures/icons/discord",
                    "$wrapper_title": "music.aboutSection.discord",
                    "$wrapper_value": "$music_ui_discord"
                }
            },
            { "s5": { "type": "panel", "size": [0, 6] } },
            {
                "copyright_footer": {
                    "type": "label",
                    "text": "music.aboutSection.copyright",
                    "color": [0.6, 0.6, 0.6],
                    "font_scale_factor": 0.75,
                    "size": ["100%", 10],
                    "text_alignment": "center",
                    "shadow": true
                }
            }
        ]
    },

    /* Tooltip Section */
    "tooltip_popup_content": {
        "type": "stack_panel",
        "controls": [
            {
                "text": {
                    "type": "label",
                    "color": "$main_header_text_color",
                    "size": ["100%", "default"],
                    "text": "music.tooltip.text"
                }
            },
            { "s1": { "type": "panel", "size": [0, 4] } },
            {
                "folder_path_row@music.popup_label_with_icon": {
                    "$wrapper_title": "music.tooltip.tip3",
                    "$wrapper_value": "Music UI/sounds/music/...",
                    "$wrapper_icon": "textures/icons/folder"
                }
            },
            { "s2": { "type": "panel", "size": [0, 2] } },
            {
                "format_file_row@music.popup_label_with_icon": {
                    "$wrapper_title": "music.tooltip.tip1",
                    "$wrapper_value": "music.tooltip.tip1.text",
                    "$wrapper_icon": "textures/icons/file"
                }
            },
            { "s3": { "type": "panel", "size": [0, 2] } },
            {
                "freq_audio_row@music.popup_label_with_icon": {
                    "$wrapper_title": "music.tooltip.tip2",
                    "$wrapper_value": "music.tooltip.tip2.text",
                    "$wrapper_icon": "textures/icons/format"
                }
            }
        ]
    },

    /* ============================================
     MUSIC SCREEN CONTENT & LAUNCHER
     ============================================ */
    "music_screen_content": {
        "type": "panel",
        "$music_screen_size|default": [346, 230],
        "controls": [
            { "music_screen_panel@music.music_screen_panel": { "layer": 4 } },
            { "about_popup@music.about_popup_overlay": {} },
            { "tooltip_popup@music.tooltip_popup_overlay": {} }
        ],
        "variables": [
            {
                "requires": "($desktop_screen or $win10_edition)",
                "$music_screen_size": [372, 250]
            },
            {
                "requires": "($touch or $pocket_screen and $pocket_edition)",
                "$music_screen_size": [320, 210]
            }
        ]
    },

    "menu_music_button@music.button": {
        "$default_content": "music.music_main_icon",
        "$hover_content": "music.music_main_icon_hover",
        "$pressed_content": "music.music_main_icon_pressed",
        "$pressed_button_name": "button.menu_buy_game",
        "size": [22, 24]
    }
}
